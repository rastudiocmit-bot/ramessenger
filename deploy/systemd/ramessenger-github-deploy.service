[Unit]
Description=Guarded Center Messenger GitHub deployment check
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/center-messenger-github
ExecStart=/usr/bin/python3 /opt/center-messenger-github/github_poll_vps.py
TimeoutStartSec=1800
NoNewPrivileges=true
UMask=0077
