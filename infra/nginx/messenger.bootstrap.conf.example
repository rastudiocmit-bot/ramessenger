# center-messenger bootstrap
server {
    listen 80;
    listen [::]:80;
    server_name messenger.rastudio.org;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/center-messenger-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 503; }
}
